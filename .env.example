# Public site URL used for SEO canonicals / sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://playlistbid.vercel.app

# Optional: Google Search Console HTML tag content value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Dodo Payments — the only payment rail. Copy to .env.local and fill in.
# Dashboard: https://app.dodopayments.com
#
# All four are server-side only: nothing about the merchant account is exposed
# to the browser. Without API_KEY + PRODUCT_ID the paddle refuses to write a
# bid and says card payments are not switched on.
# ---------------------------------------------------------------------------

# Dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=

# Dashboard → Developer → Webhooks (signing secret for /api/webhooks/dodo)
DODO_PAYMENTS_WEBHOOK_KEY=

# The product a slot is billed against. Turn on "Pay What You Want" on it so
# the bid amount can be sent per checkout (see PRICING_MODE below).
DODO_PAYMENTS_PRODUCT_ID=

# test_mode | live_mode  → picks test.dodopayments.com or live.dodopayments.com
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Where Dodo returns the payer. Defaults to <origin>/success if unset.
# Dodo appends ?status=…&payment_id=… which the receipt page reads.
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/success

# How bid dollars map to the product:
#   pwyw     = product has Pay What You Want on; we send amount in cents
#   quantity = product is priced at $1; we send quantity = bid
DODO_PAYMENTS_PRICING_MODE=pwyw

# Visitor stats — optional. Without these, counts live in server memory and
# reset whenever the app restarts (the /stats panel says so). With them, totals
# persist across deploys. Either naming works:
#   Upstash Redis  → https://console.upstash.com  (Redis database → REST API)
#   Vercel KV      → Vercel dashboard → Storage → KV (env vars are injected)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
