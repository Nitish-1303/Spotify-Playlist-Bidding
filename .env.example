# Public site URL used for SEO canonicals / sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://playlistbid.vercel.app

# Optional: Google Search Console HTML tag content value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Personal payments (no merchant account)
# PayPal.Me is hardcoded in src/lib/site.ts; UPI can be overridden here:
NEXT_PUBLIC_UPI_ID=9676446375@ybl
NEXT_PUBLIC_UPI_NAME=Yeluru Nitish
# Approximate USD → INR for UPI payment intents
NEXT_PUBLIC_USD_TO_INR=84

# Visitor stats — optional. Without these, counts live in server memory and
# reset whenever the app restarts (the /stats panel says so). With them, totals
# persist across deploys. Either naming works:
#   Upstash Redis  → https://console.upstash.com  (Redis database → REST API)
#   Vercel KV      → Vercel dashboard → Storage → KV (env vars are injected)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Dodo Payments — copy to .env.local and fill in
# Dashboard: https://app.dodopayments.com

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/success

# Client overlay mode: test | live
NEXT_PUBLIC_DODO_PAYMENTS_MODE=test

# How bid dollars map to the product:
# pwyw  = product is Pay What You Want; we send amount in cents (bid * 100)
# quantity = product price is $1; we send quantity = bid
DODO_PAYMENTS_PRICING_MODE=pwyw
